# Psychic Tribble API Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# Environment Configuration
# =============================================================================
ENV=development
DEBUG=true
APP_NAME=psychic_tribble

# =============================================================================
# Security Configuration
# =============================================================================
# IMPORTANT: Generate a secure secret key for production!
# You can use: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=development-secret-key-change-in-production-immediately

# JWT Settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Database Configuration
# =============================================================================
# Development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./development.db

# Production (PostgreSQL with async support)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/psychic_tribble

# Connection Pool Settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:3001

# =============================================================================
# Rate Limiting Configuration
# =============================================================================
DEFAULT_RATE_LIMIT=100/minute
AUTH_RATE_LIMIT=5/minute

# =============================================================================
# Redis Configuration (for rate limiting and caching)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# HTTPS Configuration
# =============================================================================
ENABLE_HTTPS_REDIRECT=false

# =============================================================================
# Secrets Management Configuration
# =============================================================================
# Options: environment, vault, aws
SECRETS_PROVIDER=environment

# HashiCorp Vault Configuration (production)
# VAULT_URL=https://vault.company.com:8200
# VAULT_TOKEN=your-vault-token

# AWS Secrets Manager Configuration (production)
# AWS_REGION=us-east-1

# =============================================================================
# Monitoring and Logging Configuration
# =============================================================================
ENABLE_METRICS=true
ENABLE_STRUCTURED_LOGGING=false
METRICS_PATH=/metrics

# API Documentation (set to false to disable in production)
ENABLE_API_DOCS=true

# =============================================================================
# Email Configuration (for notifications)
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@psychictribble.com

# =============================================================================
# Production Environment Example
# =============================================================================
# For production deployment, use these settings:
#
# ENV=production
# DEBUG=false
# SECRET_KEY=your-super-secure-64-character-secret-key-generated-securely
# DATABASE_URL=postgresql+asyncpg://user:secure_password@db:5432/psychic_tribble_prod
# BACKEND_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# ENABLE_HTTPS_REDIRECT=true
# SECRETS_PROVIDER=vault
# VAULT_URL=https://vault.company.com:8200
# VAULT_TOKEN=production-vault-token
# ENABLE_API_DOCS=false
# ENABLE_STRUCTURED_LOGGING=true
# DATABASE_POOL_SIZE=50
# DATABASE_MAX_OVERFLOW=100

# =============================================================================
# Development Notes
# =============================================================================
# 1. Never commit real secrets to version control
# 2. Use environment-specific .env files
# 3. For production, use proper secrets management (Vault/AWS)
# 4. Monitor your application with the /health and /metrics endpoints
# 5. Test API versioning with /v1/ prefix
# 6. Check request correlation with X-Request-ID headers